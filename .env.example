GCP_PROJECT=<YOUR_GCP_PROJECT>
GCP_LOCATION=us-east1
GCP_REGION=us-east1
GCP_PROJECT_NUMBER=           # numeric project number (gcloud projects describe <YOUR_GCP_PROJECT> --format="value(projectNumber)")
GCP_ORG_ID=                   # numeric org ID (gcloud organizations list)
BQ_DATASET=fsi_rm_poc
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview-04-2026

# Vertex AI Agent Engine ID (from deploy_agent.py output)
# Required for Memory Bank + persistent sessions in gateway/a2a_server.py
AGENT_ENGINE_ID=

# Agent Registry — set in production so agents discover MCP servers dynamically.
# When unset, agents fall back to *_MCP_URL env vars (local dev mode).
MCP_REGISTRY_PROJECT=<YOUR_GCP_PROJECT>
MCP_REGISTRY_LOCATION=asia-south1

# SA the Agent Engine impersonates to mint OIDC tokens for Cloud Run MCP calls.
# Agent Identity (principalSet://...) cannot invoke Cloud Run directly.
MCP_INVOKER_SA_EMAIL=fsi-rm-mcp-invoker@<YOUR_GCP_PROJECT>.iam.gserviceaccount.com

# Voice coaching — RM dashboard subscribes here to receive live hints during a call
COACH_SERVER_URL=http://localhost:8006

# External A2A agents on AWS Bedrock AgentCore — us-east-1 (deployed 2026-05-22)
# Auth: SigV4 (AWS SDK signs requests). For cross-cloud production: use Cognito OAuth instead.
# Runtime IDs: amfi=<AMFI_AGENT_RUNTIME_ID>, market=<MARKET_DATA_AGENT_RUNTIME_ID>
#              credit=<CREDIT_BUREAU_AGENT_RUNTIME_ID>, aa=<ACCOUNT_AGGREGATOR_AGENT_RUNTIME_ID>
AMFI_AGENT_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A<YOUR_AWS_ACCOUNT_ID>%3Aruntime%2F<AMFI_AGENT_RUNTIME_ID>/invocations/
MARKET_DATA_AGENT_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A<YOUR_AWS_ACCOUNT_ID>%3Aruntime%2F<MARKET_DATA_AGENT_RUNTIME_ID>/invocations/
CREDIT_BUREAU_AGENT_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A<YOUR_AWS_ACCOUNT_ID>%3Aruntime%2F<CREDIT_BUREAU_AGENT_RUNTIME_ID>/invocations/
ACCOUNT_AGGREGATOR_AGENT_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A<YOUR_AWS_ACCOUNT_ID>%3Aruntime%2F<ACCOUNT_AGGREGATOR_AGENT_RUNTIME_ID>/invocations/

# MCP server URLs (local dev)
CORE_BANKING_MCP_URL=http://localhost:8001
PORTFOLIO_MCP_URL=http://localhost:8002
COMMS_MCP_URL=http://localhost:8003
COMPLIANCE_MCP_URL=http://localhost:8004
VOICE_MCP_URL=http://localhost:8005

# Pipecat WebRTC bridge for Gemini Live API ↔ Twilio
PIPECAT_BRIDGE_URL=http://localhost:8010

# Twilio (free trial: $15.50 credit ≈ 50 calls to India)
# Get credentials: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Workspace (for Chat Bot + Gmail)
GOOGLE_CHAT_WEBHOOK_URL=
GMAIL_SERVICE_ACCOUNT_JSON=

# Optional: Sarvam AI for Hindi voice (Phase 2)
SARVAM_API_KEY=
