{
  "displayName": "Agent Teams for Relationship Managers — Observability",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6, "height": 4,
        "widget": {
          "title": "Agent Response Latency (p50 / p95 / p99)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"cloudtrace.googleapis.com/agent_latency\" resource.type=\"aiplatform.googleapis.com/AgentEngineRuntime\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_PERCENTILE_99" }
                }
              }
            }]
          }
        }
      },
      {
        "width": 6, "height": 4,
        "widget": {
          "title": "Token Usage per Agent (input + output)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" metric.label.\"gen_ai.request.model\"=monitoring.regex.full_match(\"gemini.*\")",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "groupByFields": ["metric.label.\"gen_ai.operation.name\""]
                  }
                }
              }
            }]
          }
        }
      },
      {
        "width": 4, "height": 4,
        "widget": {
          "title": "Agent Error Rate",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" metric.label.\"response_code_class\"!=\"2xx\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_RATE" }
                }
              }
            }]
          }
        }
      },
      {
        "width": 4, "height": 4,
        "widget": {
          "title": "MCP Tool Call Success / Failure",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "groupByFields": ["resource.label.\"service_name\"", "metric.label.\"response_code_class\""]
                  }
                }
              }
            }]
          }
        }
      },
      {
        "width": 4, "height": 4,
        "widget": {
          "title": "Comms Drafts — Pending RM Approval",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"custom.googleapis.com/fsi_rm/comms_drafts_pending\"",
                "aggregation": { "perSeriesAligner": "ALIGN_MEAN" }
              }
            },
            "thresholds": [
              { "value": 10, "color": "YELLOW" },
              { "value": 20, "color": "RED" }
            ]
          }
        }
      },
      {
        "width": 12, "height": 4,
        "widget": {
          "title": "Agent Invocations by Sub-Agent (last 24h)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/request_count\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "groupByFields": ["metric.label.\"gen_ai.agent.name\""]
                  }
                }
              }
            }]
          }
        }
      }
    ]
  }
}
